# ========================================
# Environment Variables Template
# Copy this file to .env and update values
# ========================================

# ========== PostgreSQL ==========
POSTGRES_USER=user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=scholarship_db

# ========== Backend Database Connection ==========
DB_HOST=postgres
DB_PORT=5432
DB_USER=user
DB_PASSWORD=your_secure_password
DB_NAME=scholarship_db

# ========== Security ==========
# JWT Secret - ควรใช้ random string ยาวๆ สำหรับ production
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# ========== CORS ==========
# Comma-separated origins
# Development: http://localhost:5173,http://localhost:5174
# Production: https://your-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ========== Frontend API URL ==========
# Development: http://localhost:8080/api
# Production: https://your-domain.com/api
VITE_API_URL=http://localhost:8080/api

# ========== PGAdmin (Optional - for development) ==========
PGADMIN_EMAIL_BROWSER=admin@example.com
PGADMIN_PASSWORD_BROWSER=admin123
