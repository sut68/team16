# ========== PostgreSQL ==========
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=test

# ========== Backend ==========
DB_HOST=postgres
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=test

# ========== Security ==========
JWT_SECRET=your_jwt_secret_key_here

# ========== Cookie Configuration ==========
# ใส่ domain หลัก เช่น .example.com (มีจุดข้างหน้าเพื่อให้ครอบคลุม subdomain)
# ถ้า Localhost ให้ปล่อยว่างไว้
COOKIE_DOMAIN=
# ถ้าขึ้น Production (HTTPS) ให้แก้เป็น true
COOKIE_SECURE=false

# ========== CORS ==========
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ========== Frontend API ==========
VITE_API_URL=http://localhost:8080/api

# ========== PGAdmin ==========
PGADMIN_EMAIL_BROWSER=admin@example.com
PGADMIN_PASSWORD_BROWSER=admin123